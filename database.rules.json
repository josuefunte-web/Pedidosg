{
  "rules": {
    ".read": false,
    ".write": false,
    "authUsers": {
      ".read": "auth != null && root.child('authUsers').child(auth.uid).child('blocked').val() !== true",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')",
        ".validate": "newData.hasChildren(['uid','email','status'])"
      }
    },
    "globalCfg": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('authUsers').child(auth.uid).child('role').val() === 'admin1'"
    },
    "orders": {
      ".read": "auth != null",
      ".indexOn": [
        "restaurant",
        "supId",
        "status",
        "createdAt"
      ],
      "$orderId": {
        ".write": "auth != null && root.child('authUsers').child(auth.uid).child('blocked').val() !== true && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2' || (!data.exists() && newData.child('restaurant').val() === root.child('authUsers').child(auth.uid).child('restaurant').val()) || (data.exists() && data.child('restaurant').val() === root.child('authUsers').child(auth.uid).child('restaurant').val() && newData.child('status').val() !== 'approved'))",
        ".validate": "newData.hasChildren(['id','restaurant','supId','items','status','createdAt','total'])"
      }
    },
    "orderComments": {
      ".read": "auth != null",
      "$orderId": {
        "$msgId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['id','uid','text','ts'])"
        }
      }
    },
    "suppliers": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "albaranes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "budgets": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('authUsers').child(auth.uid).child('role').val() === 'admin1'"
    },
    "revenue": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('authUsers').child(auth.uid).child('role').val() === 'admin1'"
    },
    "extraExpenses": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('authUsers').child(auth.uid).child('role').val() === 'admin1'"
    },
    "priceHistory": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "foodcost": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "escandallos": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "menus": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "recetas": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "templates": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "inventory": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "inventoryMovements": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "staff": {
      ".read": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "vacations": {
      ".read": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')",
      ".write": "auth != null && (root.child('authUsers').child(auth.uid).child('role').val() === 'admin1' || root.child('authUsers').child(auth.uid).child('role').val() === 'admin2')"
    },
    "auditLog": {
      ".read": "auth != null && root.child('authUsers').child(auth.uid).child('role').val() === 'admin1'",
      ".write": "auth != null"
    },
    "errorLogs": {
      ".read": "auth != null && root.child('authUsers').child(auth.uid).child('role').val() === 'admin1'",
      ".write": "auth != null"
    }
  }
}
